<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context="CreateForum">

    <include
        layout="@layout/toolbar_layout"
        app:title="Kitas ekranas" />

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="16dp">

            <!-- PAVADINIMAS -->
            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pavadinimas"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:hint="Įveskite pavadinimą"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:layout_marginBottom="16dp" />

            <!-- KATEGORIJA -->
            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kategorija"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="8dp"
                android:entries="@array/kategorijos"
                android:layout_marginBottom="16dp" />

            <!-- TURINYS -->
            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Turinys"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/editContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:maxLines="10"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:hint="Įrašykite savo mintis..."
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

        </LinearLayout>

        <!-- MYGTUKAS APAČIOJE -->
        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kurti"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
